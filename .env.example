# =============================================================================
# Backend configuration — copy to backend/.env and fill in real values:
#
#     cp .env.example backend/.env
#
# Placeholders only. Never commit a real .env file.
# Frontend variables live in frontend/.env.example.
# =============================================================================

# development | production | test
NODE_ENV=development

# Port the API listens on (Render injects PORT automatically).
PORT=4000

# Supabase → Project Settings → Database → Connection string → "Session pooler".
# Use the pooler (IPv4) rather than the direct db.<ref>.supabase.co host, which
# is IPv6-only on most plans. Do not add ?sslmode=… — TLS is set below.
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# TLS for the database connection:
#   verify-full  encrypted + certificate and hostname verified (default, recommended)
#   require      encrypted but NOT verified — only if you cannot supply the CA
#   disable      no TLS — local PostgreSQL only; rejected when NODE_ENV=production
DATABASE_SSL_MODE=verify-full

# Supabase signs its certificates with its own root CA, so verify-full needs it.
# Download it from Supabase → Project Settings → Database → SSL Configuration.
# Either point to the file (relative paths resolve from backend/) …
DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt
# … or paste the PEM inline (use \n for line breaks), e.g. on Render:
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----

# Signing secret for admin JWTs: at least 32 random characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start while this placeholder is still in place.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1h

# Origin(s) allowed to call the API (CORS). Comma-separate several, e.g.
#   https://your-app.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Number of reverse proxies in front of the API (set 1 on Render).
TRUST_PROXY=0
# error | warn | info | debug | silent
LOG_LEVEL=info
DATABASE_POOL_MAX=5
# Connection attempts at startup before the process exits.
DATABASE_CONNECT_RETRIES=5

# Public inquiry form (POST /api/inquiries): submissions allowed per client IP
# per window. Invalid attempts count too.
INQUIRY_RATE_LIMIT_MAX=10
INQUIRY_RATE_LIMIT_WINDOW_MINUTES=15
# An identical submission within this many minutes returns the existing inquiry
# (HTTP 200) instead of storing a duplicate. 0 disables the check.
INQUIRY_DUPLICATE_WINDOW_MINUTES=10

# Disposable database for `npm run test:integration` (tests roll back their
# writes, but never point this at production).
# TEST_DATABASE_URL=
