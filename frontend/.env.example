# Frontend configuration — copy to frontend/.env.local if you need to change it:
#
#     cp .env.example .env.local
#
# Everything prefixed VITE_ is embedded in the public JavaScript bundle.
# Never put secrets here; the frontend has no database or Supabase credentials.

# Base URL of the backend API, including /api.
# Leave empty in development to use the Vite proxy (same-origin /api).
# Production example (Vercel): https://edtech-crm-api.onrender.com/api
VITE_API_BASE_URL=

# Development only: where the Vite dev server proxies /api requests.
# Not exposed to the browser.
DEV_API_PROXY_TARGET=http://localhost:4000
